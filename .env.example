# Keep sample mode until a Firebase project exists and its rules have been deployed.
EXPO_PUBLIC_DATA_MODE=sample

# Public Firebase Web app configuration from Firebase Console → Project settings.
# These identify the project; do not place service-account keys or other private secrets here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps Android SDK key. Restrict it to Android app com.equalease.app
# and this app's signing certificate SHA-1; enable only Maps SDK for Android.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional OSM services. Defaults use public community endpoints; switch to a
# suitable provider or your own service if your usage grows.
EXPO_PUBLIC_OSM_OVERPASS_URL=
EXPO_PUBLIC_OSM_NOMINATIM_URL=
